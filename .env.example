# Heavenly Push - Environment Variables
# Copy this file to .env and fill in your values.

# --- AI Provider Configuration ---
# Primary AI provider: "gemini" or "openrouter"
AI_PROVIDER_PRIMARY=gemini
# Secondary (fallback) AI provider
AI_PROVIDER_SECONDARY=openrouter

# --- Google Gemini ---
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model to use for Gemini requests
GEMINI_MODEL=gemini-2.0-flash

# --- OpenRouter ---
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model identifier on OpenRouter
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# --- Bible Versions ---
# English Bible version code (BSB = Berean Standard Bible)
ENGLISH_BIBLE_VERSION=BSB
# Tamil Bible version ID (TBSI = Tamil Bible)
TAMIL_BIBLE_VERSION=TBSI

# --- Server ---
# Port for the Express API server (local dev only)
PORT=3001

# --- Google Auth ---
GOOGLE_CLIENT_ID=
