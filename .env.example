# Heavenly Push - Environment Variables
# Copy this file to .env and fill in your values.

# --- AI Provider Configuration ---
# Primary AI provider: "gemini" or "openrouter"
AI_PROVIDER_PRIMARY=openrouter
# Secondary (fallback) AI provider
AI_PROVIDER_SECONDARY=gemini

# --- Google Gemini ---
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model to use for Gemini requests
GEMINI_MODEL=gemini-2.0-flash

# --- OpenRouter ---
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model identifier on OpenRouter
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# --- Supabase (server-only; logs assistant conversations) ---
# Project URL plus either the secret key (preferred) or the publishable key
# (Settings → API Keys). The publishable key can only append rows (insert-only
# RLS policy). Never expose the secret key to the client.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# --- Bible Versions ---
# English Bible version code (BSB = Berean Standard Bible)
ENGLISH_BIBLE_VERSION=BSB
# Tamil Bible version ID (TBSI = Tamil Bible)
TAMIL_BIBLE_VERSION=TBSI

# --- Server ---
# Port for the Express API server (local dev only)
PORT=3001

# --- Google Auth (web client — set in Vercel for production builds) ---
# OAuth 2.0 Web client ID from Google Cloud Console
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Optional override; default is {current origin}/oauth
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=
# Register these in Google Cloud → Credentials → OAuth Web client:
#   Authorized JavaScript origins:
#     http://localhost:8081
#     http://127.0.0.1:8081
#     https://heavenly-push.vercel.app
#   Authorized redirect URIs:
#     http://localhost:8081/oauth
#     http://127.0.0.1:8081/oauth
#     https://heavenly-push.vercel.app/oauth
GOOGLE_CLIENT_ID=
