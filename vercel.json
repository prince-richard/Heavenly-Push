{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "excludeFiles": "{node_modules/@expo/**,node_modules/expo/**,node_modules/react-native/**,node_modules/@react-native/**,node_modules/playwright-core/**,node_modules/@playwright/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
